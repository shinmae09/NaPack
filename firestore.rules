rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // NaPack stores only reminder metadata and push tokens in Firestore.
    // Packing checklist data remains local in IndexedDB.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Deny all documents outside the authenticated user's own namespace.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
